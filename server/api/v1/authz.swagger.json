          "type": "string",
          "description": "subjectType is currently always \"user\" (OIDC `sub`); the field exists so group grants can be\nadded once the IdP is settled without a schema change."
        },
        "subject": {
          "type": "string"
        },
        "resourceType": {
          "type": "string",
          "description": "resourceType is \"template\" or \"global\"."
        },
        "namespace": {
          "type": "string"
        },
        "name": {
          "type": "string",
          "description": "name is a template name, or \"*\" for every template in the namespace."
        },
        "role": {
          "type": "string",
          "description": "role is one of viewer / operator / editor / admin."
        },
        "createdBy": {
